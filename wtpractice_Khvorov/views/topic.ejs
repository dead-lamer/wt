<%- include('partials/header') %>

<nav class="breadcrumb">
  <a href="/">Главная</a> &rsaquo;
  <% if (section) { %>
    <a href="/section/<%= section.sectionId %>"><%= section.title %></a> &rsaquo;
  <% } %>
  <span><%= topic.title %></span>
</nav>

<div class="page-hero">
  <h1 class="page-title"><%= topic.title %></h1>
  <p class="meta-item">
    Автор: <a href="/user/<%= topic.author ? topic.author.userId : '' %>">
      <%= topic.author ? topic.author.login : '—' %>
    </a>
    &nbsp;&middot;&nbsp;
    <%= new Date(topic.createdAt).toLocaleString('ru-RU') %>
  </p>
</div>


<div class="messages-list">
  <% for (const msg of messages) { %>
  <article class="message-card">
    <div class="message-card__author">
      <a href="/user/<%= msg.author ? msg.author.userId : '' %>" class="author-link">
        <%= msg.author ? msg.author.login : '—' %>
      </a>
      <span class="author-date"><%= new Date(msg.postedAt).toLocaleString('ru-RU') %></span>
    </div>
    <div class="message-card__body">
      <% if (msg.title) { %><h3 class="message-title"><%= msg.title %></h3><% } %>
      <p class="message-text"><%= msg.body %></p>
      <% if (msg.attachments && msg.attachments.length) { %>
        <div class="attachments">
          <span class="attachments-label">Вложения:</span>
          <% for (const att of msg.attachments) { %>
            <a href="<%= att.filepath %>" class="attachment-link" target="_blank">
              <% if (att.mediaType && att.mediaType.startsWith('image/')) { %>
                <%= att.filename %>
              <% } else { %>
                <%= att.filename %>
              <% } %>
              (<%= Math.round(att.filesize / 1024) %> КБ)
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
    <% if (currentUser && currentUser.role === 'moderator') { %>
    <div class="message-card__actions">
      <form method="POST" action="/message/<%= msg.messageId %>/delete" style="display:inline"
            onsubmit="return confirm('Удалить это сообщение? Это действие необратимо.')">
        <button type="submit" class="btn btn--danger btn--sm">Удалить</button>
      </form>
    </div>
    <% } %>
  </article>
  <% } %>
</div>


<% if (totalPages > 1) { %>
<div class="pagination">
  <% for (let p = 1; p <= totalPages; p++) { %>
    <a href="/topic/<%= topic.topicId %>?page=<%= p %>"
       class="page-link <%= p === currentPage ? 'page-link--active' : '' %>"><%= p %></a>
  <% } %>
</div>
<% } %>

<% if (errors && errors.length) { %>
  <ul class="error-list">
    <% for (const e of errors) { %>
      <li class="error-item"><%= e %></li>
    <% } %>
  </ul>
<% } %>


<% if (currentUser) { %>
<section class="card create-form">
  <h2 class="card-title">Ответить</h2>
  <form method="POST" action="/topic/<%= topic.topicId %>/message" enctype="multipart/form-data">
    <div class="form-group">
      <label class="form-label" for="msgTitle">Заголовок (необязательно)</label>
      <input class="form-input" type="text" id="msgTitle" name="title">
    </div>
    <div class="form-group">
      <label class="form-label" for="body">Сообщение</label>
      <textarea class="form-textarea" id="body" name="body" rows="5" required></textarea>
    </div>
    <div class="form-group">
      <label class="form-label" for="file">Прикрепить файл (необязательно)</label>
      <input class="form-input" type="file" id="file" name="file">
    </div>
    <button type="submit" class="btn btn--primary">Отправить</button>
  </form>
</section>
<% } else { %>
  <p class="info-note"><a href="/login">Войдите</a>, чтобы ответить.</p>
<% } %>

<%- include('partials/footer') %>

