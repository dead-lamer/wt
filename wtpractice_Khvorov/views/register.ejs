<%- include('partials/header') %>

<div class="auth-wrapper">
  <div class="auth-card">
    <h1 class="auth-title">Регистрация</h1>

    <% if (errors && errors.length) { %>
      <ul class="error-list">
        <% for (const e of errors) { %>
          <li class="error-item"><%= e %></li>
        <% } %>
      </ul>
    <% } %>

    <form method="POST" action="/register" class="auth-form">
      <div class="form-group">
        <label class="form-label" for="login">Логин</label>
        <input class="form-input" type="text" id="login" name="login" required autocomplete="username">
      </div>
      <div class="form-group">
        <label class="form-label" for="password">Пароль</label>
        <input class="form-input" type="password" id="password" name="password" required autocomplete="new-password">
      </div>
      <div class="form-group">
        <label class="form-label" for="confirm">Подтверждение пароля</label>
        <input class="form-input" type="password" id="confirm" name="confirm" required autocomplete="new-password">
      </div>
      <button type="submit" class="btn btn--primary btn--block">Зарегистрироваться</button>
    </form>
    <p class="auth-alt">Уже есть аккаунт? <a href="/login">Войти</a></p>
  </div>
</div>

<%- include('partials/footer') %>

